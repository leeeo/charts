{
  "name": "@leeeo/charts",
  "version": "0.4.0",
  "description": "Framework-agnostic chart core for leeeo apps: typed JSON spec -> deterministic accessible SVG string. Zero runtime dependencies; optional React adapter.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./styles.css": "./dist/chart.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts",
    "examples": "node examples/build.mjs",
    "preview": "node scripts/preview.mjs",
    "site": "node site/build.mjs",
    "site:shots": "node site/shots.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
