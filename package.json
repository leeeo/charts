{
  "name": "@leeeo/charts",
  "version": "0.8.2",
  "description": "Framework-agnostic chart core for leeeo apps: typed JSON spec -> deterministic accessible SVG string. Zero runtime dependencies; optional React adapter.",
  "keywords": [
    "chart",
    "charts",
    "svg",
    "data-visualization",
    "accessibility",
    "a11y",
    "ssr",
    "react",
    "sankey",
    "candlestick",
    "korean",
    "zero-dependency"
  ],
  "homepage": "https://charts.leeeo.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leeeo/charts.git"
  },
  "bugs": {
    "url": "https://github.com/leeeo/charts/issues"
  },
  "author": "leeeo",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./charts/*": {
      "types": "./dist/charts/*.d.ts",
      "default": "./dist/charts/*.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./styles.css": "./dist/chart.css"
  },
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "CHANGELOG.md",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts",
    "examples": "node examples/build.mjs",
    "preview": "node scripts/preview.mjs",
    "site": "node site/build.mjs",
    "site:shots": "node site/shots.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
